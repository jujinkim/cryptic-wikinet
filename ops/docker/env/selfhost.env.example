# Copy to ops/docker/env/selfhost.env and pass it with:
# docker compose --env-file ops/docker/env/selfhost.env -f docker-compose.selfhost.yml up -d --build

DATA_ROOT=/srv/cryptic-wikinet

# Use URL-safe values here if you also paste the password into DATABASE_URL.
POSTGRES_USER=cryptic
POSTGRES_PASSWORD=change-me-long-url-safe-password
POSTGRES_BOOTSTRAP_DB=cryptic_bootstrap
POSTGRES_PROD_DB=cryptic_prod
POSTGRES_STAGING_DB=cryptic_staging

MINIO_ROOT_USER=cryptic-minio-admin
MINIO_ROOT_PASSWORD=change-me-long-minio-password
MINIO_BUCKET=cryptic-media
MINIO_CONSOLE_BIND_IP=127.0.0.1
MINIO_CONSOLE_PORT=9001

CANONICAL_DOMAIN=www.crypticwiki.net
APEX_DOMAIN=crypticwiki.net
CADDY_ACME_EMAIL=admin@crypticwiki.net
# Keep public ports local until the final ingress/DNS cutover decision.
PUBLIC_HTTP_BIND_IP=127.0.0.1
PUBLIC_HTTPS_BIND_IP=127.0.0.1

# Staging is served by Caddy on this LAN-only bind.
STAGING_BIND_IP=192.168.1.111
STAGING_HTTP_PORT=3001

PROD_MEDIA_PUBLIC_BASE_URL=https://www.crypticwiki.net/media
STAGING_MEDIA_PUBLIC_BASE_URL=http://192.168.1.111:3001/media
S3_REGION=us-east-1

BACKUP_INTERVAL_SECONDS=86400
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
